---
import { productInfo } from '../data/site';

const { heading, body } = productInfo.productDetails;
---

<section class="details" id="product" aria-labelledby="product-details-heading">
	<div class="shell">
		<h2 id="product-details-heading">{heading}</h2>
		<div class="details__card">
			<p>{body}</p>
		</div>
	</div>
</section>

<style>
	.details {
		padding-block: clamp(2.5rem, 5vw, 3.75rem);
		background: var(--bg);
		border-top: 1px solid var(--line-soft);
	}

	.details h2 {
		margin: 0 0 1rem;
		font-family: var(--font-sans);
		font-size: clamp(1.15rem, 2vw, 1.35rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.2;
		color: var(--ink);
	}

	.details__card {
		padding: clamp(1.25rem, 2.4vw, 1.75rem) clamp(1.2rem, 2.2vw, 1.65rem);
		border-radius: 1.15rem;
		background: color-mix(in srgb, var(--bg-panel) 88%, #2a1420);
		border: 1px solid color-mix(in srgb, var(--magenta) 28%, var(--line));
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--magenta) 8%, transparent),
			inset 0 1px 0 color-mix(in srgb, var(--magenta-soft) 12%, transparent);
	}

	.details__card p {
		margin: 0;
		font-size: clamp(0.95rem, 1.4vw, 1.05rem);
		line-height: 1.65;
		color: var(--ink);
	}
</style>


