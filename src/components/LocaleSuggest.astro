---
import { locales, defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { localizedSlugs, type PageId } from '../data/i18n/routing';

interface Props {
	currentLocale: LocaleCode;
	pageId?: PageId;
}

const { currentLocale, pageId = 'home' } = Astro.props;

if (currentLocale !== defaultLocale) {
	return null;
}

const localeMetas = locales.map((l) => ({
	code: l.code,
	nativeName: l.nativeName,
	name: l.name,
	region: l.region,
}));
const pageSlugs = localizedSlugs[pageId] ?? {};
---

<div id="locale-suggest" class="locale-suggest" hidden role="region" aria-label="Language suggestion"></div>
<script
	is:inline
	define:vars={{ localeMetas, pageSlugs, defaultLocale, currentLocale }}
>
	(() => {
		const root = document.getElementById('locale-suggest');
		if (!root || currentLocale !== defaultLocale) return;
		if (sessionStorage.getItem('fc_locale_dismissed')) return;
		const langs = navigator.languages?.length ? navigator.languages : [navigator.language];
		let preferred = defaultLocale;
		for (const tag of langs) {
			const primary = String(tag).toLowerCase().split('-')[0];
			if (localeMetas.some((l) => l.code === primary)) {
				preferred = primary;
				break;
			}
		}
		if (preferred === defaultLocale || preferred === currentLocale) return;
		const meta = localeMetas.find((l) => l.code === preferred);
		if (!meta) return;
		const slug = pageSlugs[preferred];
		const href = slug ? `/${preferred}/${slug}/` : `/${preferred}/`;
		root.hidden = false;
		root.innerHTML =
			'<p class="locale-suggest__text">' +
			meta.nativeName +
			' (' +
			meta.region +
			') — <a href="' +
			href +
			'">' +
			meta.name +
			' version</a></p>' +
			'<button type="button" class="locale-suggest__dismiss" aria-label="Dismiss">×</button>';
		root.querySelector('a')?.addEventListener('click', () => {
			document.cookie = 'fc_locale=' + meta.code + ';path=/;max-age=31536000;SameSite=Lax';
		});
		root.querySelector('.locale-suggest__dismiss')?.addEventListener('click', () => {
			sessionStorage.setItem('fc_locale_dismissed', '1');
			root.hidden = true;
		});
	})();
</script>

<style is:global>
	.locale-suggest {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		padding: 0.55rem 1rem;
		background: color-mix(in srgb, var(--magenta) 14%, var(--bg));
		border-bottom: 1px solid color-mix(in srgb, var(--magenta) 25%, var(--line));
		font-size: 0.82rem;
		color: var(--ink-muted);
		text-align: center;
	}

	.locale-suggest[hidden] {
		display: none;
	}

	.locale-suggest__text {
		margin: 0;
	}

	.locale-suggest a {
		color: var(--magenta-soft);
		font-weight: 700;
		text-decoration: underline;
	}

	.locale-suggest__dismiss {
		border: none;
		background: transparent;
		color: var(--ink-faint);
		font-size: 1.2rem;
		line-height: 1;
		cursor: pointer;
		padding: 0.15rem 0.35rem;
	}
</style>
