---
import { locales, type LocaleCode } from '../data/i18n/locales';
import {
	getPageLocaleSwitchHref,
	resolvePageContextFromPath,
	type PageId,
} from '../data/i18n/routing';
import { getBlogLocaleSwitchHref, isBlogPath } from '../data/blog/helpers';

interface Props {
	pageId?: PageId;
	currentLocale: LocaleCode;
}

const { pageId: pageIdFallback, currentLocale } = Astro.props;
const pathname = Astro.url.pathname;
const onBlog = isBlogPath(pathname);
const pathContext = resolvePageContextFromPath(pathname);
const pageContext = onBlog
	? pathContext
	: {
			...pathContext,
			pageId: pathContext.pageId ?? pageIdFallback ?? 'home',
		};

function localeSwitchHref(targetLocale: LocaleCode): string {
	if (onBlog) {
		return getBlogLocaleSwitchHref(pathname, targetLocale);
	}
	return getPageLocaleSwitchHref(pageContext, targetLocale);
}

const options = locales.map((locale) => ({
	code: locale.code,
	label: `${locale.nativeName} (${locale.region})`,
	href: localeSwitchHref(locale.code),
}));
---

<label class="lang-switcher">
	<span class="visually-hidden">Language</span>
	<select class="lang-switcher__toggle" aria-label="Select language" data-lang-switch>
		{
			options.map((option) => (
				<option value={option.href} data-locale={option.code} selected={option.code === currentLocale}>
					{option.label}
				</option>
			))
		}
	</select>
</label>

<style>
	.lang-switcher {
		position: relative;
		display: inline-flex;
	}

	.lang-switcher__toggle {
		display: inline-flex;
		align-items: center;
		max-width: 11rem;
		padding: 0.35rem 0.5rem;
		border: 1px solid var(--color-border);
		background: transparent;
		color: var(--color-muted);
		font-size: 0.75rem;
		font-weight: 500;
		cursor: pointer;
		appearance: auto;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>

<script>
	document.querySelectorAll<HTMLSelectElement>('[data-lang-switch]').forEach((select) => {
		select.addEventListener('change', () => {
			const option = select.selectedOptions[0];
			const code = option?.getAttribute('data-locale');
			if (code) {
				document.cookie = `fc_locale=${code};path=/;max-age=31536000;SameSite=Lax`;
			}
			if (select.value) {
				window.location.assign(select.value);
			}
		});
	});
</script>
